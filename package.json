{
  "name": "@jmsalazardev/chromget",
  "version": "0.0.0",
  "description": "CLI to download Chrome binaries",
  "type": "module",
  "bin": {
    "chromget": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "download": "tsx scripts/download.ts",
    "upload": "tsx scripts/upload.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.1",
    "puppeteer": "^25.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
